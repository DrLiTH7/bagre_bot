[Unit]
Description=Bagre Bot Telegram - Downloader Assincrono
After=network-online.target
Wants=network-online.target

[Service]
# Recomendado: crie um usuário dedicado em vez de rodar como root.
# sudo useradd -r -s /bin/false bagre
# sudo chown -R bagre:bagre /opt/bagre_bot
User=bagre
Group=bagre

# Caminho completo exato (Absolute Path) de onde voce clonou o /bagre:
WorkingDirectory=/opt/bagre_bot/

# Ele deve rodar o Python de DENTRO do VENV do projeto. Substitua pelo caminho do seu repo:
ExecStart=/opt/bagre_bot/venv/bin/python3 /opt/bagre_bot/bagre.py

# Reinicia o Bot magicamente sempre que der crash ou o SV reiniciar:
Restart=always
RestartSec=5

# Otimizacoes para evitar buffers nos Logs do kernel
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
